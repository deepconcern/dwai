"An item owned by a character. If key is anything other than 'custom', it references an ItemTemplate that label/description/tags may override; for custom items, they're the sole source of truth."
type Item {
  "Quantity of a stackable resource (e.g. coins) spent as a whole unit."
  count: Int!
  "Flavour or rules text, resolved from the template unless overridden."
  description: String!
  id: ID!
  "Whether the character currently has this item worn (only meaningful for items with the 'worn' tag, e.g. armor)."
  isWorn: Boolean!
  "Key of the item template this item references, or 'custom'."
  key: String!
  "Display name, resolved from the template unless overridden."
  label: String!
  "Tags associated with the item, merged from the template and any overrides."
  tags: [Tag!]!
  "The item template this item references. Null for custom items."
  template: ItemTemplate
  "Category of item (e.g. 'weapon', 'armor', 'shield'), resolved from the template unless overridden. Empty if unset."
  type: String!
}

"A catalog entry that items may reference by key for their default data."
type ItemTemplate {
  description: String!
  key: ID!
  label: String!
  tags: [Tag!]!
}

"Namespace for item mutations."
type ItemMutation {
  "Sets whether an item is currently worn and returns the updated item."
  setWorn(id: ID!, worn: Boolean!): Item!
}

"A tag describing a property of an equipment item. Simple tags (e.g. 'close', 'worn') have no quantity; quantified tags (e.g. cost, weight, armor) carry a numeric value."
type Tag {
  "Unique key for this tag (e.g. 'close', 'cost', 'weight')."
  key: String!
  "Human-readable tag name (e.g. 'Close', 'n Coins', 'n Weight')."
  name: String!
  "Numeric value for quantified tags. Null for simple tags."
  quantity: Int
}
