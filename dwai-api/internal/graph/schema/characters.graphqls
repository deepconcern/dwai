"The six core ability scores used for all rolls and derived stats in Dungeon World."
enum Ability {
  "Charisma (CHA) — used for social manipulation, bard magic, and paladin healing."
  CHARISMA
  "Constitution (CON) — used for HP calculation and endurance rolls."
  CONSTITUTION
  "Dexterity (DEX) — used for ranged attacks, agility, and traps."
  DEXTERITY
  "Intelligence (INT) — used for knowledge checks and arcane magic (Wizard)."
  INTELLIGENCE
  "Strength (STR) — used for melee attacks and feats of force."
  STRENGTH
  "Wisdom (WIS) — used for perception, divine magic (Cleric), and nature magic (Druid/Ranger)."
  WISDOM
}

"A named condition that gives -1 to one stat's modifier until it's removed."
enum Debility {
  "Confused (-1 WIS)."
  CONFUSED
  "Scarred (-1 CHA)."
  SCARRED
  "Shaky (-1 DEX)."
  SHAKY
  "Sick (-1 CON)."
  SICK
  "Stunned (-1 INT)."
  STUNNED
  "Weak (-1 STR)."
  WEAK
}

"A type representing a character's ability score, including the base score and the derived modifier."
type AbilityScore {
  "The ability this score belongs to."
  ability: Ability!
  "The numeric modifier to use when rolling."
  modifier: Int!
  "The numeric score for this ability."
  score: Int!
}

"Input for setting an ability score when creating a character."
input AbilityScoreInput {
  "The ability this score belongs to."
  ability: Ability!
  "The numeric score for this ability."
  score: Int!
}

"A player character in the game."
type Character {
  "The character's six core ability scores, one for each ability."
  abilities: [AbilityScore!]!
  "Advanced moves the character has taken, in the order taken. A move that was replaced is gone."
  advancedMoves: [Move!]!
  "The alignment type (e.g. 'Good', 'Neutral', 'Evil')."
  alignmentType: String!
  "The description of the alignment ethos."
  alignmentDescription: String!
  "Advanced moves the character may choose at their next level up: from the 2–5 list, or either list at level 6+, respecting requires and replaces."
  availableAdvancedMoves: [Move!]!
  "Total armor: the best worn armor, plus armor bonuses from worn armor and shields. Subtracted from damage taken."
  armor: Int!
  "Whether the character has the XP to level up and isn't at the maximum level."
  canLevelUp: Boolean!
  "The character's class (e.g. Fighter, Wizard)."
  characterClass: CharacterClass!
  "Moves available to the character based on their class and choices"
  classMoves: [Move!]!
  "Active debilities. Each gives -1 to its stat's modifier; the API's modifier values don't include it."
  debilities: [Debility!]!
  "Items owned by the character."
  equipment: [Item!]!
  "Coins the character is carrying, tracked separately from equipment."
  gold: Int!
  "The character's current HP."
  hitPoints: Int!
  "Unique identifier for the character."
  id: ID!
  "Whether the character is at 0 HP and must make the Last Breath move."
  isDying: Boolean!
  "The character's level, from 1 to 10."
  level: Int!
  "How many leveled spells a Wizard's spellbook should hold (3 + 1 per level gained). Null for other classes."
  expectedSpellbookSize: Int
  "Total weight carried: each item's weight times its count."
  load: Int!
  "The character's appearance choices, one per look type."
  looks: [Look!]!
  "Maximum HP: the class's base HP plus the Constitution score."
  maxHitPoints: Int!
  "Maximum load before encumbrance: the class's base load plus the Strength modifier."
  maxLoad: Int!
  "The most spell levels the character can have prepared: level + 1. Null for classes that don't cast spells."
  maxPreparedSpellLevels: Int
  "The character's name."
  name: String!
  "Total level of the prepared spells (cantrips and rotes count 0)."
  preparedSpellLevels: Int!
  "Prepared leveled spells. Cantrips and rotes are always prepared and aren't listed."
  preparedSpells: [PreparedSpell!]!
  "The character's race move."
  raceMove: Move!
  "Leveled spells in a Wizard's spellbook. Empty for other classes."
  spellbook: [Spell!]!
  "Experience points toward the next level."
  xp: Int!
  "XP needed to level up: the current level + 7."
  xpToLevel: Int!
}

"A single appearance choice made for a character."
type Look {
  "Unique identifier for this look entry."
  id: ID!
  "The look type this value belongs to (e.g. Eyes, Hair). Null if the look type no longer exists."
  lookType: LookType!
  "The chosen appearance value (e.g. 'Wild Eyes')."
  value: String!
}

type MoveCreationOptionChoice {
  "The index of the creation option group within the move."
  choiceIndex: Int!
  "Unique identifier for this move creation option choice."
  id: ID!
  "The move this choice belongs to."
  move: Move!
  "The key of the selected option."
  optionKey: String!
}

"Input for creating a new character."
input CreateCharacterInput {
  "The character's ability scores."
  abilities: [AbilityScoreInput!]!
  "The alignment type (e.g. 'Good', 'Neutral', 'Evil')."
  alignmentType: String!
  "The description of the alignment ethos."
  alignmentDescription: String!
  "The key of the character's class (e.g. 'fighter')."
  characterClassKey: String!
  "The player's picks from each of the class's starting-gear option groups."
  gearOptionChoices: [GearOptionChoiceInput!]!
  "One look selection per look type."
  looks: [NewLookInput!]!
  "Choices made for moves that have creation options (e.g. Signature Weapon)."
  moveCreationOptionChoices: [MoveCreationOptionChoiceInput!]!
  "The character's name."
  name: String!
  "The key of the race move chosen for this character."
  raceMoveKey: String!
}

"A single look selection when creating a character."
input NewLookInput {
  "The key of the look type being set."
  lookTypeKey: String!
  "The chosen appearance value."
  value: String!
}

"A choice made for a move's creation option during character creation."
input MoveCreationOptionChoiceInput {
  "The index of the creation option group within the move."
  choiceIndex: Int!
  "The key of the move this choice belongs to."
  moveKey: String!
  "The key of the selected option."
  optionKey: String!
}

"A player's picks from one of a class's starting-gear pick-N option groups."
input GearOptionChoiceInput {
  "Indices into options[optionIndex].choices that the player picked."
  choiceIndices: [Int!]!
  "Index into the class's StartingGear.options."
  optionIndex: Int!
}

"Input for leveling up."
input LevelUpInput {
  "The ability whose score rises by 1 (it must be under 18)."
  ability: Ability!
  "The key of the advanced move to take; it must be in availableAdvancedMoves."
  advancedMoveKey: String!
}

"Input for taking damage."
input TakeDamageInput {
  "The damage rolled, before armor."
  amount: Int!
  "Whether the damage ignores armor entirely."
  ignoresArmor: Boolean! = false
  "How much armor the damage ignores (the piercing tag)."
  piercing: Int! = 0
}

"Namespace for character queries."
type CharacterQuery {
  "Returns all characters."
  all: [Character!]!
  "Returns a single character by ID, or null if not found."
  byId(id: ID!): Character!
}

"Namespace for character mutations."
type CharacterMutation {
  "Adds delta (positive or negative) to the character's gold. The result can't be negative."
  adjustGold(delta: Int!, id: ID!): Character!
  "Adds delta (positive or negative) to the character's XP. The result can't be negative."
  adjustXp(delta: Int!, id: ID!): Character!
  "Creates a new character and returns it."
  create(input: CreateCharacterInput!): Character!
  "Heals the character by amount, up to their maximum HP."
  heal(amount: Int!, id: ID!): Character!
  "Levels up: spends level + 7 XP, raises the level and one ability score by 1, and adds an advanced move (losing any move it replaces)."
  levelUp(id: ID!, input: LevelUpInput!): Character!
  "Sets or clears one debility."
  setDebility(active: Boolean!, debility: Debility!, id: ID!): Character!
  "Applies damage: armor (less piercing, unless ignored) is subtracted first, and HP doesn't drop below 0."
  takeDamage(id: ID!, input: TakeDamageInput!): Character!
}
