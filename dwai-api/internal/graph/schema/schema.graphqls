"An RFC 3339 timestamp."
scalar Time

type Query {
  "Current API version string."
  apiVersion: String!
  "Queries for campaigns."
  campaigns: CampaignQuery!
  "Queries for character classes (e.g. Fighter, Wizard)."
  characterClasses: CharacterClassQuery!
  "Queries for player characters."
  characters: CharacterQuery!
  "Queries for the item template catalog."
  itemTemplates: ItemTemplateQuery!
  "Queries for look types used when building a character's appearance."
  lookTypes: LookTypeQuery!
  "The logged-in user, or null when logged out."
  me: User
  "Queries for moves available to characters."
  moves: MoveQuery!
  "Queries for Wizard and Cleric spells."
  spells: SpellQuery!
}

type Mutation {
  "Mutations for logging in and out and registering."
  auth: AuthMutation!
  "Mutations for campaigns, invites, and End of Session."
  campaigns: CampaignMutation!
  "Mutations for player characters."
  characters: CharacterMutation!
  "Mutations for items owned by characters."
  items: ItemMutation!
  "Mutations for a character's spellbook and prepared spells."
  spells: SpellMutation!
}
